          "type": "string",
          "description": "Clear goal and architectural scope."
        },
        "tasks": {
          "type": "array",
          "description": "List of specialized agent assignments to execute concurrently in parallel.",
          "items": {
            "type": "object",
            "properties": {
              "agentId": {
                "type": "string",
                "description": "Specialist agent ID (e.g. agent-architect, agent-senior-engineer, agent-qa-synthesizer, agent-secops-auditor, agent-devops-sre)."
