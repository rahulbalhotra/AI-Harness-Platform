              "role": {
                "type": "string",
                "description": "Role description for this parallel task."
              },
              "taskDescription": {
                "type": "string",
                "description": "Specific task instructions and requirements for the agent."
              }
            },
            "required": [
              "agentId",
              "taskDescription"
            ]
          }
        }
      },
      "required": [
        "planTitle",
        "tasks"
      ]
    },
    "enabled": true,
    "isSystem": true
