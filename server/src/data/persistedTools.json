          "type": "string",
          "description": "Specific task instructions and requirements for the specialist agent."
        }
      },
      "required": [
        "agentId",
        "taskDescription"
      ]
    },
    "enabled": true,
    "isSystem": true
  },
  {
    "version": 1,
