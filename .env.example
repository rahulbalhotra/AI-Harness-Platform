# =======================================================
# Enterprise AI Harness Platform - Model Provider API Keys
# =======================================================

# Google Gemini / Vertex AI API Key
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Anthropic Claude API Key
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI API Key (GPT-4o, o1, o3-mini)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# DeepSeek API Key (DeepSeek-R1, DeepSeek-V3)
# Get key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Azure OpenAI Service
# Get credentials: Azure Portal -> Azure OpenAI Resource -> Keys and Endpoint
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Port for the Harness Engine Server (default: 4000)
PORT=4000
